{
  "name": "@repo/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "cf:typegen": "wrangler types",
    "cf:migrate": "wrangler d1 migrations apply kordeon-waitlist --remote",
    "cf:migrate:preview": "wrangler d1 migrations apply kordeon-waitlist-preview --remote --env preview",
    "cf:deploy": "bun run cf:migrate && wrangler deploy",
    "cf:deploy:preview": "bun run cf:migrate:preview && wrangler versions upload --env preview",
    "deploy": "bun run build && bun run cf:deploy",
    "check:types": "bun run cf:typegen && tsc"
  },
  "dependencies": {
    "@repo/domain": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "@tanstack/router-plugin": "^1.168.19",
    "gpt-tokenizer": "^3.4.0",
    "kysely": "^0.29.3",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.1",
    "@cloudflare/workers-types": "^4.20260701.1",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "catalog:",
    "vite": "^8.1.3",
    "wrangler": "^4.107.1"
  }
}
