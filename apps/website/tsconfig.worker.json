{
  // The Cloudflare Worker (src/worker.ts) lives in the Workers runtime, not the DOM, so
  // it's type-checked separately from the React app: `@cloudflare/workers-types` supplies
  // the runtime globals (Request, Response, Fetcher, ExportedHandler, …). The app's
  // tsconfig.json excludes this file for the same reason.
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/worker.ts"]
}
